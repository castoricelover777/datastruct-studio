{
  "name": "datastruct-studio",
  "productName": "DataStruct Studio",
  "version": "2.1.0",
  "description": "数据结构研习社 (DataStruct Studio) —— 面向陈越《数据结构》的代码解剖、动画演示与默写训练平台",
  "main": "electron/main.js",
  "author": "DataStruct Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "data": "node tools/build-data.js",
    "anim": "node tools/make-animations.js",
    "verify": "node tools/verify.js",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.datastructstudio.app",
    "productName": "DataStruct Studio",
    "copyright": "DataStruct Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "shared/**/*",
      "src/**/*",
      "data/**/*",
      "docs/animations/**/*.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tcc",
        "to": "tcc"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DataStruct-Studio-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "DataStruct-Studio-${version}-portable.exe",
      "unpackDirName": "DataStructStudio"
    },
    "compression": "maximum"
  }
}
